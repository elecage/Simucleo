        { "type": "brightness", "kind": "led-5mm", "above": 0.5, "below": 0.1, "label": "램프가 켜졌다 꺼짐" },
        { "type": "display", "kind": "oled-ssd1306", "minPixels": 100, "label": "OLED에 온도 표시" }
