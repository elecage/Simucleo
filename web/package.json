{
  "name": "simucleo-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "cargo build --release --target wasm32-unknown-unknown -p simucleo-wasm && wasm-bindgen --target web --out-dir src/wasm/pkg ../target/wasm32-unknown-unknown/release/simucleo_wasm.wasm",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --test test/*.test.ts",
    "preview": "vite preview",
    "e2e": "playwright test",
    "examples": "node scripts/examples.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
